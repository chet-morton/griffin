<div data-command-palette-target="modal" class="hidden fixed inset-0 z-50 overflow-y-auto p-4 sm:p-6 md:p-20 bg-black/85 backdrop-blur-md flex items-start justify-center">
  <div class="w-full max-w-xl bg-rust-onion-card rust-border border-[#C85A32] shadow-2xl overflow-hidden font-mono" data-action="click->event#stopPropagation">
    <div class="flex items-center px-4 border-b border-[#8B3A2B]/40 bg-[#180B0E]">
      <span class="text-base mr-3 shrink-0">🐿️</span>
      <input type="text"
             data-command-palette-target="input"
             data-action="input->command-palette#search"
             placeholder="Search jobs or candidates..."
             class="w-full h-12 bg-transparent text-xs text-[#F4E8D7] placeholder-[#A47F6E] focus:outline-none uppercase font-mono tracking-wider" />
      <button type="button" data-action="click->command-palette#close" class="text-[10px] text-[#D4B499] hover:text-[#F4E8D7] px-2 py-1 bg-[#281217] rust-border font-bold uppercase">ESC</button>
    </div>

    <div data-command-palette-target="resultsContainer" class="max-h-80 overflow-y-auto divide-y divide-[#281217] p-2">
      <p class="text-xs text-[#A47F6E] p-4 font-sans">Type a candidate name or job title to search...</p>
    </div>

    <div class="px-4 py-2 bg-[#180B0E] border-t border-[#281217] flex items-center justify-between text-[10px] text-[#A47F6E] font-mono">
      <span>Press <kbd class="px-1 py-0.5 bg-[#281217] text-[#E58A67]">⌘K</kbd> anytime to open</span>
      <span>Griffin ATS</span>
    </div>
  </div>
</div>
