<div class="flex-1 overflow-y-auto p-8 space-y-8 font-mono bg-gradient-to-b from-[#180B0E] via-[#220E13] to-[#14080B] max-w-2xl mx-auto w-full">
  <div class="border-b border-[#8B3A2B]/40 pb-6">
    <div class="text-[10px] text-[#E58A67] tracking-widest uppercase font-bold">[NEW] // CATALOG REQUISITION</div>
    <h1 class="text-2xl font-extrabold text-[#F4E8D7] font-sans uppercase mt-1">CREATE JOB REQUISITION</h1>
  </div>

  <%= form_with model: @job_posting, class: "space-y-6 bg-rust-onion-card rust-border p-8 shadow-xl" do |f| %>
    <div class="space-y-2">
      <label class="text-xs font-bold text-[#D4B499] uppercase tracking-wider block">Job Title</label>
      <%= f.text_field :title, placeholder: "E.G. PRINCIPAL RAILS ARCHITECT", class: "w-full bg-[#180B0E] rust-border p-3 text-xs text-[#F4E8D7] placeholder-[#A47F6E] uppercase focus:border-[#C85A32] focus:outline-none" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div class="space-y-2">
        <label class="text-xs font-bold text-[#D4B499] uppercase tracking-wider block">Department</label>
        <%= f.text_field :department, placeholder: "E.G. ENGINEERING", class: "w-full bg-[#180B0E] rust-border p-3 text-xs text-[#F4E8D7] placeholder-[#A47F6E] uppercase focus:border-[#C85A32] focus:outline-none" %>
      </div>

      <div class="space-y-2">
        <label class="text-xs font-bold text-[#D4B499] uppercase tracking-wider block">Location</label>
        <%= f.text_field :location, placeholder: "E.G. SAN FRANCISCO, CA", class: "w-full bg-[#180B0E] rust-border p-3 text-xs text-[#F4E8D7] placeholder-[#A47F6E] uppercase focus:border-[#C85A32] focus:outline-none" %>
      </div>
    </div>

    <div class="space-y-2">
      <label class="text-xs font-bold text-[#D4B499] uppercase tracking-wider block">Description</label>
      <%= f.text_area :description, rows: 4, placeholder: "ENTER REQUISITION SCOPE AND REQUIREMENTS...", class: "w-full bg-[#180B0E] rust-border p-3 text-xs text-[#F4E8D7] placeholder-[#A47F6E] uppercase focus:border-[#C85A32] focus:outline-none" %>
    </div>

    <div class="flex items-center justify-between pt-4 border-t border-[#8B3A2B]/40">
      <%= link_to "CANCEL", job_postings_path, class: "text-xs font-bold text-[#A47F6E] hover:text-[#F4E8D7] uppercase" %>
      <%= f.submit "SAVE REQUISITION", class: "px-6 py-2.5 text-xs font-bold text-white bg-rust-onion-btn cursor-pointer uppercase tracking-wider shadow-lg shadow-[#C85A32]/20" %>
    </div>
  <% end %>
</div>
