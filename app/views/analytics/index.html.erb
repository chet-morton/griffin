<div class="flex-1 overflow-y-auto p-8 space-y-8 font-sans">
  <div class="flex items-end justify-between border-b border-[#8B3A2B]/40 pb-6">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#F4E8D7]">Reports & Analytics</h1>
      <p class="text-xs text-[#D4B499] mt-1 font-mono">Overview of candidate quality, hiring activity, and pipeline metrics.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <%= render StatCalloutComponent.new(label: "Total Candidates", value: @total_candidates.to_s, change: "+14%", trend: :up) %>
    <%= render StatCalloutComponent.new(label: "Active Job Openings", value: @active_jobs.to_s, change: "+3", trend: :up) %>
    <%= render StatCalloutComponent.new(label: "Average Quality Score", value: "#{@avg_quality_score} / 5.0", change: "+0.3", trend: :up) %>
    <%= render StatCalloutComponent.new(label: "Pipeline Status", value: "Optimal", change: "0 Bottlenecks", trend: :up) %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="bg-rust-onion-card rust-border p-6 space-y-4 shadow-md">
      <h2 class="text-xs font-bold uppercase tracking-wider text-[#A47F6E] font-mono">Highest Rated Candidates</h2>
      <div class="space-y-3">
        <% @top_candidates.each do |cand| %>
          <div class="flex items-center justify-between p-4 bg-[#180B0E] rust-border">
            <div>
              <span class="text-xs font-bold text-[#F4E8D7]"><%= cand.full_name %></span>
              <span class="text-[11px] text-[#D4B499] block font-mono"><%= cand.title %></span>
            </div>
            <%= render CandidateFitBadgeComponent.new(score: cand.fit_score) %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-rust-onion-card rust-border p-6 space-y-4 shadow-md">
      <h2 class="text-xs font-bold uppercase tracking-wider text-[#A47F6E] font-mono">Applicant Count by Position</h2>
      <div class="space-y-3 text-xs text-[#D4B499]">
        <% @recent_postings.each do |job| %>
          <div class="flex items-center justify-between p-4 bg-[#180B0E] rust-border font-mono">
            <div>
              <span class="font-bold text-[#F4E8D7] font-sans"><%= job.title %></span>
              <span class="text-[10px] text-[#D4B499] block"><%= job.company&.name || "General Client" %></span>
            </div>
            <span class="font-bold text-[#E58A67]"><%= job.candidate_applications.count %> Applicants</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
