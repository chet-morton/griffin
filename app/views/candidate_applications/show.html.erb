<div class="flex-1 flex flex-col h-full font-sans overflow-hidden"
     data-controller="keyboard-nav evaluation-matrix"
     data-keyboard-nav-next-url-value="<%= candidate_application_path(@next_application_id) if @next_application_id %>"
     data-keyboard-nav-prev-url-value="<%= candidate_application_path(@prev_application_id) if @prev_application_id %>">

  <!-- Header Bar -->
  <div class="h-14 border-b border-[#8B3A2B]/40 bg-[#1D0C10]/90 px-8 flex items-center justify-between shrink-0 font-mono">
    <div class="flex items-center space-x-4">
      <%= link_to job_posting_pipeline_path(@job_posting), class: "p-2 text-[#D4B499] hover:text-[#F4E8D7] bg-[#180B0E] rust-border text-xs" do %>
        ← Back to Pipeline
      <% end %>

      <div>
        <h1 class="text-xs font-bold text-[#F4E8D7] flex items-center space-x-2 tracking-wider">
          <span><%= @candidate.full_name %></span>
          <span class="text-[#E58A67]">•</span>
          <span class="text-[#E58A67]"><%= @job_posting.title %></span>
        </h1>
      </div>
    </div>

    <!-- Stepper Navigation -->
    <div class="flex items-center space-x-4 text-xs text-[#D4B499]">
      <span class="hidden sm:inline text-[11px]">Navigate: <kbd class="px-1.5 py-0.5 bg-[#2A1218] text-[#E58A67] rust-border font-bold">J</kbd> next / <kbd class="px-1.5 py-0.5 bg-[#2A1218] text-[#E58A67] rust-border font-bold">K</kbd> prev</span>
      
      <div class="flex items-center space-x-2 border-l border-[#8B3A2B]/40 pl-4">
        <% if @prev_application_id %>
          <%= link_to candidate_application_path(@prev_application_id), class: "px-2 py-1 bg-[#2A1218] hover:bg-[#3D1A22] text-[#F4E8D7] rust-border font-bold text-[10px]" do %>
            ← Previous (K)
          <% end %>
        <% end %>

        <% if @next_application_id %>
          <%= link_to candidate_application_path(@next_application_id), class: "px-2 py-1 bg-rust-onion-btn text-white font-bold text-[10px] shadow-md" do %>
            Next Candidate (J) →
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Split Pane Layout -->
  <div class="flex-1 flex overflow-hidden">
    <!-- LEFT PANE: Resume Artifact -->
    <div class="w-1/2 border-r border-[#8B3A2B]/40 bg-[#180B0E] flex flex-col h-full overflow-hidden p-6 space-y-6">
      <div class="bg-rust-onion-card rust-border p-6 space-y-4 shadow-lg">
        <div class="flex items-start justify-between">
          <div>
            <span class="text-xs text-[#E58A67] font-bold font-mono">Candidate Profile</span>
            <h2 class="text-2xl font-bold text-[#F4E8D7] mt-1"><%= @candidate.full_name %></h2>
            <p class="text-xs text-[#D4B499] mt-1 font-mono"><%= @candidate.title %> • <%= @candidate.email %></p>
          </div>

          <div class="text-right font-mono">
            <span class="text-[10px] text-[#A47F6E] uppercase tracking-widest block">Weighted Score</span>
            <div class="text-3xl font-extrabold text-[#E58A67]" data-evaluation-matrix-target="overallScoreDisplay">
              <%= @application.overall_score || "0.00" %>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 text-xs pt-3 border-t border-[#8B3A2B]/30 font-mono">
          <div class="bg-[#180B0E] p-3 rust-border">
            <span class="text-[#A47F6E] text-[10px] block uppercase">Current Stage</span>
            <span class="text-[#F4E8D7] font-bold"><%= @application.current_stage.name %></span>
          </div>
          <div class="bg-[#180B0E] p-3 rust-border">
            <span class="text-[#A47F6E] text-[10px] block uppercase">Estimated Comp</span>
            <span class="text-[#E58A67] font-bold">$<%= number_with_delimiter(@candidate.estimated_compensation) %> / yr</span>
          </div>
        </div>
      </div>

      <!-- Raw Resume Text -->
      <div class="flex-1 overflow-y-auto space-y-3">
        <div class="text-xs text-[#A47F6E] font-bold font-mono uppercase">Candidate Resume Text</div>
        <div class="bg-rust-onion-card rust-border p-6 font-mono text-xs text-[#D4B499] whitespace-pre-wrap leading-relaxed shadow-inner">
          <%= @candidate.resume_text %>
        </div>
      </div>
    </div>

    <!-- RIGHT PANE: Interactive Rubric Matrix Form -->
    <div class="w-1/2 bg-[#180B0E] flex flex-col h-full overflow-hidden">
      <div class="p-4 border-b border-[#8B3A2B]/40 bg-[#1D0C10] shrink-0 font-mono">
        <h3 class="text-xs font-bold text-[#F4E8D7] uppercase tracking-wider">Skill Matrix Evaluation</h3>
        <p class="text-xs text-[#D4B499] mt-0.5">Rate candidate performance on key skill rubrics (1 = Low, 5 = High)</p>
      </div>

      <!-- Evaluation Form -->
      <%= form_with url: candidate_application_evaluations_path(@application), method: :post, class: "flex-1 flex flex-col overflow-hidden" do |f| %>
        <div class="flex-1 p-6 overflow-y-auto space-y-6">
          <% @skill_requirements.each do |skill| %>
            <% existing_eval = @evaluations_by_requirement[skill.id] %>
            <% current_score = existing_eval&.score || 0 %>

            <div class="bg-rust-onion-card rust-border p-5 space-y-4 shadow-md"
                 data-evaluation-matrix-target="requirementRow"
                 data-weight="<%= skill.weight %>"
                 data-min-score="<%= skill.minimum_score %>">

              <div class="flex items-start justify-between">
                <div>
                  <div class="flex items-center space-x-3">
                    <h4 class="text-sm font-bold text-[#F4E8D7]"><%= skill.name %></h4>
                    <span class="px-2 py-0.5 text-[10px] font-bold bg-[#2A1218] text-[#D4B499] rust-border font-mono">
                      Weight: <%= skill.weight %> (min: <%= skill.minimum_score %>)
                    </span>
                  </div>
                  <p class="text-xs text-[#D4B499] mt-1"><%= skill.rubric_description %></p>
                </div>

                <span data-status-badge class="px-2 py-0.5 text-[10px] font-bold uppercase bg-[#2A1218] text-[#A47F6E] rust-border font-mono">
                  Unrated
                </span>
              </div>

              <!-- Rating Selection Buttons (1-5) -->
              <div class="flex items-center justify-between pt-3 border-t border-[#8B3A2B]/30 font-mono">
                <span class="text-xs font-bold text-[#D4B499]">Score:</span>
                <div class="flex space-x-2">
                  <% (1..5).each do |num| %>
                    <label class="cursor-pointer">
                      <input type="radio"
                             name="evaluations[<%= skill.id %>][score]"
                             value="<%= num %>"
                             <%= "checked" if current_score == num %>
                             data-action="change->evaluation-matrix#scoreChanged"
                             class="peer sr-only" />
                      <div class="w-10 h-10 bg-[#180B0E] rust-border text-[#D4B499] flex items-center justify-center text-xs font-bold peer-checked:bg-gradient-to-br peer-checked:from-[#C85A32] peer-checked:to-[#6E243A] peer-checked:border-[#C85A32] peer-checked:text-white hover:bg-[#2A1218] transition-all">
                        <%= num %>
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>

              <div>
                <textarea name="evaluations[<%= skill.id %>][notes]"
                          rows="2"
                          placeholder="Add notes or feedback for this skill..."
                          class="w-full bg-[#180B0E] rust-border p-3 text-xs text-[#F4E8D7] placeholder-[#A47F6E] focus:border-[#C85A32] focus:outline-none"></textarea>
              </div>
            </div>
          <% end %>
        </div>

        <div class="p-4 border-t border-[#8B3A2B]/40 bg-[#1D0C10] flex items-center justify-between shrink-0 font-mono">
          <span class="text-[11px] text-[#D4B499]">Evaluator: <strong class="text-[#F4E8D7]"><%= @current_evaluator.name %></strong></span>
          <%= f.submit "Save Evaluation", class: "px-6 py-2.5 text-xs font-bold text-white bg-rust-onion-btn cursor-pointer transition-all uppercase tracking-wider shadow-lg shadow-[#C85A32]/20" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
